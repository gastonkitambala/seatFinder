# Organizer password for the admin dashboard. Change this before deploying.
ADMIN_PASSWORD=change-me-before-the-wedding

# Random secret used to sign the admin session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Where the SQLite database file lives. Must be on a persistent volume in production.
DATABASE_PATH=./data/seatfinder.db
